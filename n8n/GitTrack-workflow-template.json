    {
      "parameters": {
        "jsCode": "// Get the lastChecked value from GitTrackState\nconst state = $input.first().json;\n\nconst lastChecked = new Date(state.lastChecked);\n\n// Get the GitHub events from Get Activity\nconst events = $(\"Get Activity\").all();\n\n// Keep only PushEvents that happened after lastChecked\nconst newEvents = events.filter(item => {\n  return (\n    item.json.type === \"PushEvent\" &&\n    new Date(item.json.created_at) > lastChecked\n  );\n});\n\nreturn newEvents;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        112
      ],
      "id": "d9b1a9c3-1b92-4b30-b98a-2c86f5e6b2fb",
      "name": "Filter New Events"
    },
    {
      "parameters": {
        "jsCode": "const events = $input.all();\n\nlet email = `\n<h2>🚀 GitTrack - New GitHub Updates</h2>\n<p>You have <b>${events.length}</b> new push event(s).</p>\n<hr>\n`;\n\nfor (const item of events) {\n  const event = item.json;\n\n  const username = event.actor.login;\n  const repo = event.repo.name;\n  const branch = event.payload.ref.replace(\"refs/heads/\", \"\");\n  const commit = event.payload.head;\n  const time = new Date(event.created_at).toLocaleString(\"en-IN\", {\n    timeZone: \"Asia/Kolkata\"\n  });\n\n  const commitUrl = `https://github.com/${repo}/commit/${commit}`;\n\n  email += `\n    <div>\n      <p>👤 <b>${username}</b></p>\n      <p>📦 Repository: <b>${repo}</b></p>\n      <p>🌿 Branch: <b>${branch}</b></p>\n      <p>🕐 Time: ${time}</p>\n      <p>🔗 <a href=\"${commitUrl}\">View commit</a></p>\n    </div>\n    <hr>\n  `;\n}\n\nreturn [\n  {\n    json: {\n      subject: `GitTrack: ${events.length} new GitHub update(s)`,\n      emailBody: email\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
